{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "types": [
      "node"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "rootDir": "source",
    "outDir": "lib",
    "declaration": true,
    "noEmitOnError": true,
    "sourceMap": false
  },
  "include": [
    "source/**/*.ts"
  ]
}
