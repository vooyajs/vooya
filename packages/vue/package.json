{
  "name": "@vooya/vue",
  "version": "0.1.0-alpha.11",
  "description": "Vue host adapter for Vooya component islands.",
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vooyajs/vooya.git",
    "directory": "packages/vue"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --external vue --tsconfig tsconfig.json --clean",
    "test": "npm run build && node --test src/*.test.js"
  },
  "peerDependencies": {
    "vue": ">=3.5.2"
  }
}
