{
  "name": "@vooya/svelte",
  "version": "0.1.0-alpha.11",
  "description": "Svelte host adapter for Vooya component islands.",
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vooyajs/vooya.git",
    "directory": "packages/svelte"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "svelte": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "svelte-package --input src --output dist",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "npm run check && npm run build && node --test test/*.test.js"
  },
  "peerDependencies": {
    "svelte": ">=5 <6"
  },
  "dependencies": {
    "esm-env": "^1.2.2"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.5.8",
    "svelte-check": "^4.7.6"
  }
}
