{
  "name": "@vooya/build-core",
  "version": "0.2.0-alpha.0",
  "description": "Compatibility entry point for Vooya Rust builds.",
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vooyajs/vooya.git",
    "directory": "packages/build-core"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "npm run build --prefix ../provider-rust && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.js"
  },
  "dependencies": {
    "@vooya/provider-rust": "0.2.0-alpha.0"
  }
}
