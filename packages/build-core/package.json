{
  "name": "@vooya/build-core",
  "version": "0.1.0-alpha.7",
  "description": "Bundler-neutral Rust/WASM build core for Vooya component islands.",
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "repository": { "type": "git", "url": "git+https://github.com/vooyajs/vooya.git", "directory": "packages/build-core" },
  "publishConfig": { "access": "public" },
  "files": ["dist", "LICENSE-MIT", "LICENSE-APACHE"],
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "scripts": { "build": "npm run build --prefix ../compiler && tsc -p tsconfig.json", "typecheck": "tsc --noEmit -p tsconfig.json", "test": "npm run build && node --test test/*.test.js" },
  "dependencies": { "@vooya/compiler": "0.1.0-alpha.7", "@vooya/core": "0.1.0-alpha.7" }
}
