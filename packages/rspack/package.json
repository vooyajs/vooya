{
  "name": "@vooya/rspack",
  "version": "0.1.0-alpha.11",
  "description": "Experimental Rspack and Rsbuild integration for Vooya source components.",
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vooyajs/vooya.git",
    "directory": "packages/rspack"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    }
  },
  "scripts": {
    "build": "npm run build --prefix ../compiler && npm run build --prefix ../build-core && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.js"
  },
  "dependencies": {
    "@vooya/build-core": "0.1.0-alpha.11",
    "@vooya/compiler": "0.1.0-alpha.11"
  },
  "peerDependencies": {
    "@rspack/core": ">=2.1.10"
  }
}
