{
  "name": "@vooya/core",
  "version": "0.1.0-alpha.10",
  "description": "Vooya's browser WASM runtime.",
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vooyajs/vooya.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "rust",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "exports": {
    ".": {
      "types": "./dist/vooya_app.d.ts",
      "import": "./dist/vooya_app.js"
    },
    "./rust/Cargo.toml": "./rust/Cargo.toml"
  },
  "scripts": {
    "build": "npm run build:core --prefix ../.."
  }
}
