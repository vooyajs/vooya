{
  "name": "@vooya/vite",
  "version": "0.1.0-alpha.11",
  "description": "Vite integration for Vooya component islands.",
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vooyajs/vooya.git",
    "directory": "packages/vite"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "voo-format": "./bin/voo-format.mjs",
    "vooya": "./bin/vooya.mjs"
  },
  "files": [
    "bin",
    "dist",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./build": {
      "types": "./dist/build-core.d.ts",
      "import": "./dist/build-core.js"
    },
    "./format": {
      "types": "./dist/voo-format.d.ts",
      "import": "./dist/voo-format.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    }
  },
  "scripts": {
    "build": "npm run build --prefix ../compiler && npm run build --prefix ../build-core && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test src/*.test.js"
  },
  "peerDependencies": {
    "vite": ">=7 <9"
  },
  "dependencies": {
    "@vooya/build-core": "0.1.0-alpha.11",
    "@vooya/core": "0.1.0-alpha.11",
    "@vooya/compiler": "0.1.0-alpha.11"
  }
}
