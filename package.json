{
  "name": "vooya",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:core": "node scripts/build-core.mjs",
    "dev:vue": "vite --config examples/vue-counter/vite.config.js",
    "build:vue": "vite build --config examples/vue-counter/vite.config.js",
    "typecheck": "node packages/vite-plugin/src/generate-declarations.mjs examples/vue-counter vue && vue-tsc --noEmit -p examples/vue-counter/tsconfig.json",
    "dev:benchmark": "vite --config examples/data-grid-benchmark/vite.config.js",
    "build:benchmark": "vite build --config examples/data-grid-benchmark/vite.config.js",
    "typecheck:benchmark": "node packages/vite-plugin/src/generate-declarations.mjs examples/data-grid-benchmark vue && vue-tsc --noEmit -p examples/data-grid-benchmark/tsconfig.json",
    "dev:tasks": "vite --config examples/task-list/vite.config.js",
    "build:tasks": "vite build --config examples/task-list/vite.config.js",
    "typecheck:tasks": "node packages/vite-plugin/src/generate-declarations.mjs examples/task-list vue && vue-tsc --noEmit -p examples/task-list/tsconfig.json",
    "dev:react": "vite --config examples/react-counter/vite.config.js",
    "build:react": "vite build --config examples/react-counter/vite.config.js",
    "typecheck:react": "node packages/vite-plugin/src/generate-declarations.mjs examples/react-counter react && tsc --noEmit -p examples/react-counter/tsconfig.json",
    "format:voo": "node packages/vite-plugin/bin/voo-format.mjs examples tests/fixtures",
    "format:voo:check": "node packages/vite-plugin/bin/voo-format.mjs --check examples tests/fixtures",
    "verify:editor": "node scripts/verify-vscode-extension.mjs && npm run package:editor",
    "verify:branding": "node scripts/verify-branding.mjs",
    "verify:docs": "node scripts/verify-docs.mjs",
    "compatibility:generate": "node scripts/generate-compatibility.mjs",
    "compatibility:check": "node scripts/generate-compatibility.mjs --check",
    "package:editor": "mkdir -p dist && cd editors/vscode && vsce package --no-dependencies --out ../../dist/voo-vscode.vsix",
    "changeset": "changeset",
    "version:packages": "changeset version",
    "verify:versions": "node scripts/verify-package-versions.mjs",
    "test:voo": "npm test --workspace @vooya/vite-plugin",
    "test:portable": "node tests/portable-build.mjs",
    "test:hmr": "npm run build:packages && node tests/hmr.mjs",
    "test:e2e": "npm run build:packages && node tests/e2e/run.mjs",
    "verify:release": "npm run verify:branding && npm run verify:docs && npm run compatibility:check && npm run verify:versions && node scripts/sync-alpha-dist-tags.mjs --dry-run && npm run format:voo:check && npm run verify:editor && cargo test -p vooya-core && npm run test:voo && npm run typecheck && npm run typecheck:react && npm run typecheck:tasks && npm run typecheck:benchmark && npm run test:e2e && npm run test:portable && npm run test:hmr && npm run pack:check",
    "release:alpha": "npm run verify:release && npm run build:packages && changeset publish && node scripts/sync-alpha-dist-tags.mjs",
    "build:packages": "npm run build --workspace @vooya/core && npm run build --workspace @vooya/vue && npm run build --workspace @vooya/react",
    "pack:check": "npm run build:packages && npm pack --dry-run --workspace @vooya/core && npm pack --dry-run --workspace @vooya/vite-plugin && npm pack --dry-run --workspace @vooya/vue && npm pack --dry-run --workspace @vooya/react"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@playwright/test": "^1.62.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vscode/vsce": "^3.9.2",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.5.1",
    "typescript": "~5.5.4",
    "vite": "^7.0.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2",
    "vue": "^3.5.0",
    "vue-tsc": "^2.1.0"
  }
}
